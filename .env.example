# ===== Discord =====
DISCORD_BOT_TOKEN=
# IDs de cargos administradores, separados por virgula
ADMIN_ROLE_IDS=
# IDs dos servidores onde registrar os comandos (vazio = todos)
DISCORD_GUILD_IDS=
# guild ou global
DISCORD_COMMAND_SCOPE=guild
WELCOME_ROLE_ID=1461496253245423841
PRESENCE_CLIENT_ROLE_ID=1461496253245423843
TEBEX_PURCHASE_CHANNEL_ID=

# ===== Logs / console =====
# debug, info, warn ou error
LOG_LEVEL=info
# Canal do Discord que recebe avisos e erros agrupados (vazio = desligado)
LOG_CHANNEL_ID=
# Nivel minimo enviado ao canal: warn ou error
LOG_DISCORD_LEVEL=warn
# Cores no terminal (padrao: automatico)
LOG_COLORS=
# Salvar logs em arquivos diarios na pasta logs/
LOG_TO_FILE=false
LOG_DIR=./logs

# ===== Tebex =====
TEBEX_PUBLIC_TOKEN=
TEBEX_PRIVATE_KEY=
TEBEX_PLUGIN_SECRET=
# Obrigatorio para aceitar webhooks. Sem ele, todo webhook e recusado.
TEBEX_WEBHOOK_SECRET=
TEBEX_WEBHOOK_PATH=/webhooks/tebex
TEBEX_COMPLETE_URL=
TEBEX_CANCEL_URL=
# JSON map: package_id -> role_id
# Exemplo: {"7330019":"987654321098765432"}
TEBEX_PACKAGE_ROLE_MAP={"7330019":"SEU_ROLE_ID_DISCORD"}

# ===== Servidor HTTP =====
WEB_HOST=0.0.0.0
PORT=3000
# Limite de POSTs por IP por minuto nas rotas /api
HTTP_RATE_LIMIT_PER_MINUTE=20
